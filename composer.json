{
    "name": "lumera/nlp",
    "description": "NLP Lumera for Lumera Editorial Application with PSR-4/PSR-12 standards",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Rochmady",
            "email": "rochmady@sangia.org"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Lumera\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lumera\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage"
    }
}
